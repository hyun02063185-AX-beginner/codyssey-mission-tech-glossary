            {
              "speaker": "동료",
              "text": "자주 보는 건\n가까이 두면 되죠."
            }
          ],
          "imageSrc": "webtoons/cache-menu-01/panel-1.webp",
          "smallImageSrc": "webtoons/cache-menu-01/panel-1-368.webp",
          "width": 736,
          "height": 480
