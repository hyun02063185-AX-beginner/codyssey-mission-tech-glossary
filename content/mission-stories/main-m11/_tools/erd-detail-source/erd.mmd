    STUDENT {
        INTEGER id PK
        TEXT name "NOT NULL"
        TEXT email "UNIQUE"
        TEXT school
        TEXT school_level
        INTEGER grade
        DATE joined_at
    }
    TEACHER {
        INTEGER id PK
        TEXT name "NOT NULL"
        TEXT phone "UNIQUE"
    }
    SUBJECT {
        INTEGER id PK
        TEXT name "UNIQUE"
    }
    COURSE {
        INTEGER id PK
        TEXT course_name "NOT NULL"
        INTEGER subject_id FK
        INTEGER teacher_id FK
        TEXT weekday
    }
    ENROLLMENT {
        INTEGER id PK
        INTEGER student_id FK
        INTEGER course_id FK
        DATE enrolled_at
    }
    SCORE {
        INTEGER id PK
        INTEGER enrollment_id FK
        DATE exam_date
        INTEGER point
    }
