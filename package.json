{
  "name": "codyssey-mission-tech-glossary",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "data:build": "python3 scripts/build_technology_field_atlas.py && python3 scripts/build_frontend_m01_overlay.py && python3 scripts/build_wave1_mission_overlays.py && python3 scripts/build_wave2_knowledge_maps.py && python3 scripts/build_web_data.py",
    "dev": "npm run data:build && vite",
    "build": "npm run data:build && tsc -b && vite build",
    "test": "npm run data:build && vitest run",
    "build:extension": "npm run data:build && python3 scripts/build_extension.py",
    "knowledge-map:overlay": "python3 scripts/build_frontend_m01_overlay.py",
    "knowledge-map:validate": "npm run data:build && python3 scripts/validate_knowledge_map.py",
    "atlas:build": "python3 scripts/build_technology_field_atlas.py",
    "atlas:validate": "npm run atlas:build && python3 scripts/validate_technology_field_atlas.py",
    "package:extension": "npm run build:extension && python3 scripts/package_extension.py"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
