{
  "name": "codyssey-mission-tech-glossary",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "data:build": "python3 scripts/build_technology_field_atlas.py && python3 scripts/build_frontend_m01_overlay.py && python3 scripts/build_wave2_knowledge_maps.py && python3 scripts/build_wave3_knowledge_maps.py && python3 scripts/build_wave1_mission_overlays.py && python3 scripts/curate_knowledge_map_references.py && python3 scripts/build_web_data.py && python3 scripts/build_field_search.py && python3 scripts/build_term_map_links.py && npm run encyclopedia:validate && python3 -X utf8 scripts/validate_mission_concept_map.py",
    "dev": "npm run data:build && vite",
    "build": "npm run b21:validate && npm run data:build && tsc -b && vite build && npm run b21:build-check",
    "test": "npm run data:build && vitest run",
    "test:map-interaction": "playwright test",
    "build:extension": "npm run data:build && python3 scripts/build_extension.py",
    "knowledge-map:overlay": "python3 scripts/build_frontend_m01_overlay.py",
    "knowledge-map:validate": "npm run data:build && python3 scripts/validate_knowledge_map.py",
    "atlas:build": "python3 scripts/build_technology_field_atlas.py",
    "atlas:validate": "npm run atlas:build && python3 scripts/validate_technology_field_atlas.py",
    "glossary:validate": "python3 scripts/validate_glossary.py",
    "content:integrity": "python3 scripts/validate_content_integrity.py",
    "encyclopedia:build": "python3 scripts/build_encyclopedia_graph.py",
    "encyclopedia:validate": "npm run encyclopedia:build && python3 scripts/validate_encyclopedia.py",
    "encyclopedia:coverage": "python3 scripts/report_coverage_review.py",
    "encyclopedia:coverage:freeze": "python3 scripts/report_coverage_review.py --freeze",
    "content:plan": "python3 scripts/build_content_tier_plan.py",
    "content:plan:validate": "python3 scripts/validate_content_tier_plan.py",
    "content:s7-b01:validate": "python3 scripts/validate_s7_b01_content.py",
    "package:extension": "npm run build:extension && python3 scripts/package_extension.py",
    "content:quality": "python3 scripts/report_content_quality.py",
    "content:specificity": "python3 scripts/audit_term_specificity.py",
    "content:map-reasons": "python3 scripts/audit_map_reasons.py",
    "content:readability": "python3 scripts/audit_learner_readability.py",
    "learner:pilot": "python3 scripts/build_pilot_comparison.py --write",
    "learner:plan": "python3 scripts/build_learner_test_plan.py --write",
    "search:fields": "python3 scripts/build_field_search.py",
    "qa:console": "python3 scripts/qa_console_encoding.py",
    "b21:v3-parity": "node scripts/check_b21_v3_parity.mjs",
    "b21:v3-validate": "node scripts/b21_v3_content_check.mjs",
    "b21:validate": "node scripts/b21_story_integrity.mjs",
    "b21:build-check": "node scripts/check_b21_foundation_build.mjs",
    "b21:browser-check": "node scripts/check_b21_foundation_browser.mjs",
    "b21:eol-check": "node scripts/check_b21_eol.mjs",
    "b21:router-check": "node scripts/check_b21_router_browser.mjs",
    "b21:html-qa": "node scripts/check_b21_html_qa.mjs",
    "b21:preview": "node scripts/b21_preview.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/mdast": "4.0.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
